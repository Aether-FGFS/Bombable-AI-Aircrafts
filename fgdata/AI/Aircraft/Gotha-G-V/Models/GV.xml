<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList include="Gotha-G-V-bombableinclude.xml">

  <path>GV.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>GV</object-name>
    <object-name>bolG</object-name>
    <object-name>bolD</object-name>
    <object-name>interior</object-name>
    <object-name>seat</object-name>
    <object-name>panel</object-name>
    <object-name>pilots</object-name>

    <object-name>heliceG</object-name>
    <object-name>heliceD</object-name>

    <object-name>propdiscG</object-name>
    <object-name>propblurG</object-name>
    <object-name>propdiscD</object-name>
    <object-name>propblurD</object-name>
  </animation>
  <!--
  <animation>
    <type>material</type>
    <object-name>GV</object-name>
    <object-name>bolG</object-name>
    <object-name>bolD</object-name>
    <object-name>heliceG</object-name>
    <object-name>heliceD</object-name>
    <object-name>propdiscG</object-name>
    <object-name>propblurG</object-name>
    <object-name>propdiscD</object-name>
    <object-name>propblurD</object-name>
    <property-base>/ai/models/multiplayer/sim/multiplay/generic</property-base>
    <texture-prop>string[1]</texture-prop>
    <texture>/ai/models/multiplayer/sim/multiplay/generic/string[1]</texture>
  </animation>
  -->

  <model>
    <path>Effects/Weapons/3D/all-bombs.xml</path>
  </model>

  <model>
    <path>Effects/Weapons/3D/all-guns.xml</path>
  </model>

  <model>
    <path>Engine/all-engines.xml</path>
  </model>

  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>propdiscG</object-name>
    <object-name>propblurG</object-name>
    <object-name>propdiscD</object-name>
    <object-name>propblurD</object-name>
  </effect>

  <!-- L'hélice -->
  <animation>
    <name>HeliceCompleteG</name>
    <object-name>heliceG</object-name>
    <object-name>bolG</object-name>
    <object-name>propdiscG</object-name>
    <object-name>propblurG</object-name>
  </animation>

  <!-- Séléction de l'objet visible en fonction des rpm -->
  <animation>
    <type>select</type>
    <object-name>propdiscG</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>14</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblurG</object-name>
    <condition>
      <and>
        <greater-than>
          <property>velocities/true-airspeed-kt</property>
          <value>60</value>
        </greater-than>
        <less-than>
          <property>velocities/true-airspeed-kt</property>
          <value>101</value>
        </less-than>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>heliceG</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>101</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>HeliceCompleteG</object-name>
    <property>velocities/true-airspeed-kt</property>
    <factor> 1 </factor>
    <center>
      <x-m> -1.72894 </x-m>
      <y-m> -2.15470 </y-m>
      <z-m>  0.23544 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- L'hélice -->
  <animation>
    <name>HeliceCompleteD</name>
    <object-name>heliceD</object-name>
    <object-name>bolD</object-name>
    <object-name>propdiscD</object-name>
    <object-name>propblurD</object-name>
  </animation>

  <!-- Séléction de l'objet visible en fonction des rpm -->
  <animation>
    <type>select</type>
    <object-name>propdiscD</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>14</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblurD</object-name>
    <condition>
      <and>
        <greater-than>
          <property>velocities/true-airspeed-kt</property>
          <value>60</value>
        </greater-than>
        <less-than>
          <property>velocities/true-airspeed-kt</property>
          <value>101</value>
        </less-than>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>heliceD</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>101</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>HeliceCompleteD</object-name>
    <property>velocities/true-airspeed-kt</property>
    <factor> 1 </factor>
    <center>
      <x-m> -1.72894 </x-m>
      <y-m>  2.15470 </y-m>
      <z-m>  0.23544 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>
