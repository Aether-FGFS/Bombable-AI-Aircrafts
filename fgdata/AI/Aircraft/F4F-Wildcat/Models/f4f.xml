<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList include="F4F-Wildcat-bombableinclude.xml">

  <path>f4f.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>f4f</object-name>
    <object-name>aileG</object-name>
    <object-name>aileD</object-name>
    <object-name>bol</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>

    <object-name>helice</object-name>
    <object-name>heliceD</object-name>
    <object-name>rouessorties</object-name>
    <object-name>rouesrentrees</object-name>

    <object-name>propdisc</object-name>
    <object-name>propblur</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>f4f</object-name>
    <object-name>aileG</object-name>
    <object-name>aileD</object-name>
    <object-name>bol</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>
    <object-name>helice</object-name>
    <object-name>heliceD</object-name>
    <object-name>rouessorties</object-name>
    <object-name>rouesrentrees</object-name>
    <object-name>propdisc</object-name>
    <object-name>propblur</object-name>
    <property-base>/ai/models/multiplayer/sim/multiplay/generic</property-base>
    <texture-prop>string[1]</texture-prop>
    <texture>/ai/models/multiplayer/sim/multiplay/generic/string[1]</texture>
  </animation>

  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>propdisc</object-name>
    <object-name>propblur</object-name>
  </effect>

  <model>
    <path>Engines/all-engines.xml</path>
  </model>

  <model>
    <path>Effects/light/all-lights.xml</path>
  </model>

  <!-- L'hélice -->
  <animation>
    <name>HeliceComplete</name>
    <object-name>helice</object-name>
    <object-name>bol</object-name>
    <object-name>propdisc</object-name>
    <object-name>propblur</object-name>
  </animation>

  <!-- Séléction de l'objet visible en fonction des rpm -->
  <animation>
    <type>select</type>
    <object-name>propdisc</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>14</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblur</object-name>
    <condition>
      <and>
        <greater-than>
          <property>velocities/true-airspeed-kt</property>
          <value>60</value>
        </greater-than>
        <less-than>
          <property>velocities/true-airspeed-kt</property>
          <value>101</value>
        </less-than>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>helice</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>101</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>HeliceComplete</object-name>
    <property>velocities/true-airspeed-kt</property>
    <factor> 1 </factor>
    <center>
      <x-m> -3.94500 </x-m>
      <y-m>  0.00000 </y-m>
      <z-m> -0.14675 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>aileG</object-name>
    <!-- <property>sim/model/door-positions/wings/position-norm</property> -->
    <property>/ai/models/multiplayer/sim/multiplay/generic/float[1]</property>
    <factor>-110</factor>
    <axis>
      <x1-m> -1.57723 </x1-m>
      <y1-m> -1.83266 </y1-m>
      <z1-m>  0.15226 </z1-m>
      <x2-m> -1.72523 </x2-m>
      <y2-m> -1.69966 </y2-m>
      <z2-m> -0.07374 </z2-m>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>aileD</object-name>
    <!-- <property>sim/model/door-positions/wings/position-norm</property> -->
    <property>/ai/models/multiplayer/sim/multiplay/generic/float[1]</property>
    <factor>-110</factor>
    <axis>
      <x1-m> -1.72523 </x1-m>
      <y1-m>  1.69966 </y1-m>
      <z1-m> -0.07374 </z1-m>
      <x2-m> -1.57723 </x2-m>
      <y2-m>  1.83266 </y2-m>
      <z2-m>  0.15226 </z2-m>
    </axis>
  </animation>

  <!-- Roues sorties -->
  <animation>
    <type>select</type>
    <object-name>rouessorties</object-name>
    <object-name>portesouvertes</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>60</value>
      </less-than>
    </condition>
  </animation>

  <!-- Roues rentrée -->
  <animation>
    <type>select</type>
    <object-name>rouesrentrees</object-name>
    <object-name>portesfermees</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>59</value>
      </greater-than>
    </condition>
  </animation>

</PropertyList>
