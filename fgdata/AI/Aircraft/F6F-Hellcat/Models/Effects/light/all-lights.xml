<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <model>
    <name>Beacon1On</name>
    <path>beacon.xml</path>
    <offsets>
      <x-m> 1.64461 </x-m>
      <y-m> 0.00000 </y-m>
      <z-m> 0.54728 </z-m>
    </offsets>
  </model>

  <animation>
    <name>BeaconOn</name>
    <object-name>Beacon1On</object-name>
  </animation>

  <model>
    <name>Beacon1Off</name>
    <path>empty.xml</path>
    <offsets>
      <x-m> 1.64461 </x-m>
      <y-m> 0.00000 </y-m>
      <z-m> 0.54728 </z-m>
    </offsets>
  </model>

  <animation>
    <name>BeaconOff</name>
    <object-name>Beacon1Off</object-name>
  </animation>

  <animation>
    <name>BeaconStrobe</name>
    <type>timed</type>
    <object-name>BeaconOn</object-name>
    <object-name>BeaconOff</object-name>
    <use-personality type="bool">true</use-personality>
    <branch-duration-sec>0.1</branch-duration-sec>
    <branch-duration-sec>1.0</branch-duration-sec>
  </animation>

  <model>
    <name>Strobe1-Light</name>
    <path>StrobeLight.xml</path>
    <offsets>
      <x-m> -1.63670 </x-m>
      <y-m> -5.77946 </y-m>
      <z-m>  0.25798 </z-m>
    </offsets>
  </model>

  <model>
    <name>Strobe2-Light</name>
    <path>StrobeLight.xml</path>
    <offsets>
      <x-m> -1.63670 </x-m>
      <y-m>  5.77946 </y-m>
      <z-m>  0.25798 </z-m>
    </offsets>
  </model>

  <animation>
    <name>AllStrobeLight</name>
    <object-name>Strobe1-Light</object-name>
    <object-name>Strobe2-Light</object-name>
  </animation>

  <model>
    <name>StrobeOff1</name>
    <path>empty.xml</path>
    <offsets>
      <x-m> -1.63670 </x-m>
      <y-m> -5.77946 </y-m>
      <z-m>  0.25798 </z-m>
    </offsets>
  </model>

  <model>
    <name>StrobeOff2</name>
    <path>empty.xml</path>
    <offsets>
      <x-m> -1.63670 </x-m>
      <y-m>  5.77946 </y-m>
      <z-m>  0.25798 </z-m>
    </offsets>
  </model>

  <animation>
    <name>AllStrobeOff</name>
    <object-name>StrobeOff1</object-name>
    <object-name>StrobeOff2</object-name>
  </animation>

  <animation>
    <name>timed_strobe</name>
    <type>timed</type>
    <object-name>AllStrobeLight</object-name>
    <object-name>AllStrobeOff</object-name>
    <use-personality type="bool">true</use-personality>
    <branch-duration-sec>0.1</branch-duration-sec>
    <branch-duration-sec>1.0</branch-duration-sec>
  </animation>

  <model>
    <name>RedLightLeft</name>
    <path>RedLight.xml</path>
    <offsets>
      <x-m> -1.65303 </x-m>
      <y-m> -5.78033 </y-m>
      <z-m>  0.25798 </z-m>
    </offsets>
  </model>

  <model>
    <name>GreenLightLeft</name>
    <path>GreenLight.xml</path>
    <offsets>
      <x-m> -1.65303 </x-m>
      <y-m>  5.78033 </y-m>
      <z-m>  0.25798 </z-m>
    </offsets>
  </model>

  <!-- Pliage des ailes -->
  <animation>
    <name>LightAileGauche</name>
    <object-name>Strobe1-Light</object-name>
    <object-name>StrobeOff1</object-name>
    <object-name>RedLightLeft</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>LightAileGauche</object-name>
    <!-- <property>sim/model/door-positions/wings/position-norm</property> -->
    <property>/ai/models/multiplayer/sim/multiplay/generic/float[1]</property>
    <factor>-110</factor>
    <axis>
      <x1-m> -1.57723 </x1-m>
      <y1-m> -1.83266 </y1-m>
      <z1-m>  0.15226 </z1-m>
      <x2-m> -1.72523 </x2-m>
      <y2-m> -1.69966 </y2-m>
      <z2-m> -0.07374 </z2-m>
    </axis>
  </animation>

  <animation>
    <name>LightAileDroite</name>
    <object-name>Strobe2-Light</object-name>
    <object-name>StrobeOff2</object-name>
    <object-name>GreenLightLeft</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>LightAileDroite</object-name>
    <!-- <property>sim/model/door-positions/wings/position-norm</property> -->
    <property>/ai/models/multiplayer/sim/multiplay/generic/float[1]</property>
    <factor>-110</factor>
    <axis>
      <x1-m> -1.72523 </x1-m>
      <y1-m>  1.69966 </y1-m>
      <z1-m> -0.07374 </z1-m>
      <x2-m> -1.57723 </x2-m>
      <y2-m>  1.83266 </y2-m>
      <z2-m>  0.15226 </z2-m>
    </axis>
  </animation>

</PropertyList>
