<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>rocket.ac</path>

  <animation>
    <object-name>rocket</object-name>
    <object-name>flame-one</object-name>
    <object-name>flame-two</object-name>
  </animation>

  <model>
    <path>trail.xml</path>
    <offsets>
      <x-m> 2 </x-m>
      <y-m> 0 </y-m>
      <z-m> 0 </z-m>
    </offsets>
  </model>

  <!--  Rotate flame -->
  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>flame-one</object-name>
    <object-name>flame-two</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>flame-one</object-name>
    <object-name>flame-two</object-name>
    <emission>
      <red>   255 </red>
      <green> 255 </green>
      <blue>  254 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>flame-one</object-name>
    <property>/sim/time/elapsed-sec</property>
    <factor> -30 </factor>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>flame-two</object-name>
    <property>/sim/time/elapsed-sec</property>
    <factor> 40 </factor>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
