    <eda>0.00338158219</eda>
    <weight>0.0234</weight>
    <life>0.6</life>
    <repeat>true</repeat>
    <delay>0.1</delay>
    <count>-1</count>
    <wind>false</wind>
    <collision>true</collision>
    <impact>true</impact>
    <collision-report>sim/ai/aircraft/collision/gun</collision-report>
    <impact-report>sim/ai/aircraft/impact/bullet</impact-report>
    <submodel-path>Aircraft/T-34/Models/Effects/Weapons/guns/12mm/12mm-submodel.xml</submodel-path>
    <animation>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    </animation>
    <offsets>
      <x-m>0.9</x-m>
      <y-m>0.6</y-m>
      <z-m>0.3</z-m>
      <heading-deg>sim/multiplay/generic/float[13]</heading-deg>
      <pitch-deg>sim/multiplay/generic/float[12]</pitch-deg>
    </offsets>
  </submodel>

</PropertyList>