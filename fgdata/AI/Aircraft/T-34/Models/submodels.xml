<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <!-- ============================================================
       T-34 - Submodels
       Cannon:          key "e"  →  sim/multiplay/generic/int[10]
       Coax. MG:        key "g"  →  sim/multiplay/generic/int[11]
       AA MG:           key "y"  →  sim/multiplay/generic/int[12]
       
       Turret Weapons:  float[8]=heading, sub-heading=negovaný
                        float[9]=pitch
       AA MG:           float[10]=heading, float[11]=pitch
  ============================================================ -->

  <!-- Shared cannon definition — 76mm F-34 (~655 m/s) -->
  <cannon>
    <name>76mm shell</name>
    <model>Aircraft/T-34/Models/Effects/Weapons/cannon/Tracer/s8-smoke.xml</model>
    <trigger>sim/multiplay/generic/int[10]</trigger>
    <speed>2148.9</speed>
    <cd>0.193</cd>
    <eda>0.00338158219</eda>
    <weight>13.5</weight>
    <life>10</life>
    <repeat>false</repeat>
    <delay>0.1</delay>
    <count>-1</count>
    <wind>false</wind>
    <collision>true</collision>
    <impact>true</impact>
    <collision-report>sim/ai/aircraft/collision/cannon</collision-report>
    <impact-report>sim/ai/aircraft/impact/bullet</impact-report>
    <submodel-path>Aircraft/T-34/Models/Effects/Weapons/cannon/Impact/cannon-impact.xml</submodel-path>
    <animation>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    </animation>
  </cannon>

  <!-- Shared MG definition — DT 7.62mm (~840 m/s) -->
  <mg>
    <name>gun</name>
    <model>Aircraft/T-34/Models/Effects/Weapons/guns/12mm/apibullet-tracer.xml</model>
    <trigger>sim/multiplay/generic/int[11]</trigger>
    <speed>2755.9</speed>
    <cd>0.193</cd>
    <eda>0.00338158219</eda>
    <weight>0.0234</weight>
    <life>0.6</life>
    <repeat>true</repeat>
    <delay>0.1</delay>
    <count>-1</count>
    <wind>false</wind>
    <collision>true</collision>
    <impact>true</impact>
    <collision-report>sim/ai/aircraft/collision/gun</collision-report>
    <impact-report>sim/ai/aircraft/impact/bullet</impact-report>
    <submodel-path>Aircraft/T-34/Models/Effects/Weapons/guns/12mm/12mm-submodel.xml</submodel-path>
    <animation>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    </animation>
  </mg>

  <!-- ============================================================
       CANNON 76mm F-34
  ============================================================ -->
  <submodel>
    <name>76mm shell</name>
    <model            alias="../../cannon/model"/>
    <trigger          alias="../../cannon/trigger"/>
    <speed            alias="../../cannon/speed"/>
    <cd               alias="../../cannon/cd"/>
    <eda              alias="../../cannon/eda"/>
    <weight           alias="../../cannon/weight"/>
    <life             alias="../../cannon/life"/>
    <repeat           alias="../../cannon/repeat"/>
    <delay            alias="../../cannon/delay"/>
    <count            alias="../../cannon/count"/>
    <wind             alias="../../cannon/wind"/>
    <collision        alias="../../cannon/collision"/>
    <impact           alias="../../cannon/impact"/>
    <collision-report alias="../../cannon/collision-report"/>
    <impact-report    alias="../../cannon/impact-report"/>
    <submodel-path    alias="../../cannon/submodel-path"/>
    <animation        alias="../../cannon/animation"/>
    <animation>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    </animation>
    <offsets>
      <x-m>0.0</x-m>
      <y-m>0.0</y-m>
      <z-m>1.1</z-m>
      <heading-deg>sim/model/t34/sub-heading</heading-deg>
      <pitch-deg>sim/multiplay/generic/float[9]</pitch-deg>
    </offsets>
  </submodel>

  <!-- ============================================================
       COAXIAL DT MG
  ============================================================ -->
  <submodel>
    <name>gun</name>
    <model            alias="../../mg/model"/>
    <trigger          alias="../../mg/trigger"/>
    <speed            alias="../../mg/speed"/>
    <cd               alias="../../mg/cd"/>
    <eda              alias="../../mg/eda"/>
    <weight           alias="../../mg/weight"/>
    <life             alias="../../mg/life"/>
    <repeat           alias="../../mg/repeat"/>
    <delay            alias="../../mg/delay"/>
    <count            alias="../../mg/count"/>
    <wind             alias="../../mg/wind"/>
    <collision        alias="../../mg/collision"/>
    <impact           alias="../../mg/impact"/>
    <collision-report alias="../../mg/collision-report"/>
    <impact-report    alias="../../mg/impact-report"/>
    <submodel-path    alias="../../mg/submodel-path"/>
    <animation        alias="../../mg/animation"/>
    <animation>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    </animation>
    <offsets>
      <x-m>0.0</x-m>
      <y-m>0.0</y-m>
      <z-m>0.9</z-m>
      <heading-deg>sim/model/t34/sub-heading</heading-deg>
      <pitch-deg>sim/multiplay/generic/float[9]</pitch-deg>
    </offsets>
  </submodel>

  <!-- ============================================================
       AA DT MG — Up at turret (Fliegerabwehr)
       Key "y" → int[12]
       Turning: float[10]=heading, float[11]=pitch
  ============================================================ -->
  <submodel>
    <name>aa-gun</name>
    <model>Aircraft/T-34/Models/Effects/Weapons/guns/12mm/apibullet-tracer.xml</model>
    <trigger>sim/multiplay/generic/int[12]</trigger>
    <speed>2755.9</speed>
    <cd>0.193</cd>
    <eda>0.00338158219</eda>
    <weight>0.0234</weight>
    <life>0.6</life>
    <repeat>true</repeat>
    <delay>0.08</delay>
    <count>-1</count>
    <wind>false</wind>
    <collision>true</collision>
    <impact>true</impact>
    <collision-report>sim/ai/aircraft/collision/gun</collision-report>
    <impact-report>sim/ai/aircraft/impact/bullet</impact-report>
    <submodel-path>Aircraft/T-34/Models/Effects/Weapons/guns/12mm/12mm-submodel.xml</submodel-path>
    <animation>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    </animation>
    <offsets>
      <x-m>0.3</x-m>
      <y-m>-0.5</y-m>
      <z-m>1.7</z-m>
      <heading-deg>sim/multiplay/generic/float[10]</heading-deg>
      <pitch-deg>sim/multiplay/generic/float[11]</pitch-deg>
    </offsets>
  </submodel>

<!-- ============================================================
       Font DT MG — radista right front
       Key "n" → int[13]
       Range: H ±15°, V -5° až +15°
  ============================================================ -->
  <submodel>
