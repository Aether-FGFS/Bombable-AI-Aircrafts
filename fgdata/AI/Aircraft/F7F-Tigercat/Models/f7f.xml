<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList include="F7F-Tigercat-bombableinclude.xml">

  <path>f7f.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>f7f</object-name>
    <object-name>bol1</object-name>
    <object-name>bol2</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>

    <object-name>helice1</object-name>
    <object-name>helice2</object-name>
    <object-name>rouessorties</object-name>

    <object-name>propdisc1</object-name>
    <object-name>propblur1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propblur2</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>f7f</object-name>
    <object-name>bol1</object-name>
    <object-name>bol2</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>
    <object-name>helice1</object-name>
    <object-name>helice2</object-name>
    <object-name>rouessorties</object-name>
    <object-name>propdisc1</object-name>
    <object-name>propblur1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propblur2</object-name>

    <property-base>sim/model/livery</property-base>
    <texture-prop>texture</texture-prop>
    <texture>texture.png</texture>
    <specular>
      <red-prop>specular/red</red-prop>
      <green-prop>specular/green</green-prop>
      <blue-prop>specular/blue</blue-prop>
    </specular>
  </animation>

  <effect>
    <inherits-from>AI/Aircraft/F7F-Tigercat/Models/Effects/Bump/bumpspec</inherits-from>
    <object-name>f7f</object-name>
    <object-name>bol1</object-name>
    <object-name>bol2</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>
  </effect>

  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>propdisc1</object-name>
    <object-name>propblur1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propblur2</object-name>
  </effect>

  <!-- L'hélice -->
  <animation>
    <name>HeliceComplete1</name>
    <object-name>helice1</object-name>
    <object-name>bol1</object-name>
    <object-name>propdisc1</object-name>
    <object-name>propblur1</object-name>
  </animation>

  <model>
    <path>Engines/all-engines.xml</path>
  </model>

  <!-- Séléction de l'objet visible en fonction des rpm -->
  <animation>
    <type>select</type>
    <object-name>propdisc1</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>14</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblur1</object-name>
    <condition>
      <and>
        <greater-than>
          <property>velocities/true-airspeed-kt</property>
          <value>60</value>
        </greater-than>
        <less-than>
          <property>velocities/true-airspeed-kt</property>
          <value>101</value>
        </less-than>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>helice1</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>101</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>HeliceComplete1</object-name>
    <property>velocities/true-airspeed-kt</property>
    <factor> 10 </factor>
    <center>
      <x-m> -3.723 </x-m>
      <y-m> -2.981 </y-m>
      <z-m> -0.277 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- L'hélice -->
  <animation>
    <name>HeliceComplete2</name>
    <object-name>helice2</object-name>
    <object-name>bol2</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propblur2</object-name>
  </animation>

  <!-- Séléction de l'objet visible en fonction des rpm -->
  <animation>
    <type>select</type>
    <object-name>propdisc2</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>14</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblur2</object-name>
    <condition>
      <and>
        <greater-than>
          <property>velocities/true-airspeed-kt</property>
          <value>60</value>
        </greater-than>
        <less-than>
          <property>velocities/true-airspeed-kt</property>
          <value>101</value>
        </less-than>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>helice2</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>101</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>HeliceComplete2</object-name>
    <property>velocities/true-airspeed-kt</property>
    <factor> 10 </factor>
    <center>
      <x-m> -3.723 </x-m>
      <y-m>  2.981 </y-m>
      <z-m> -0.277 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Roues sorties -->
  <animation>
    <type>select</type>
    <object-name>rouessorties</object-name>
    <object-name>portesouvertes</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>60</value>
      </less-than>
    </condition>
  </animation>

  <!-- Roues rentrée -->
  <animation>
    <type>select</type>
    <object-name>portesfermees</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>59</value>
      </greater-than>
    </condition>
  </animation>

</PropertyList>
