<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList include="Messerschmitt-P1101-bombableinclude.xml">

  <path>p1101.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>p1101</object-name>
    <object-name>modeA</object-name>
    <object-name>modeB</object-name>
    <object-name>radar</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>

    <object-name>rouessorties</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>p1101</object-name>
    <object-name>modeA</object-name>
    <object-name>modeB</object-name>
    <object-name>radar</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>
    <object-name>rouessorties</object-name>
    <property-base>/ai/models/multiplayer/sim/multiplay/generic</property-base>
    <texture-prop>string[1]</texture-prop>
    <texture>/ai/models/multiplayer/sim/multiplay/generic/string[1]</texture>
  </animation>

  <!-- ************** Mode A ************** -->
  <animation>
    <type>select</type>
    <object-name>modeA</object-name>
    <condition>
      <equals>
        <!-- <property>sim/model/mode</property> -->
        <property>/ai/models/multiplayer/sim/multiplay/generic/string[0]</property>
        <value>modeA</value>
      </equals>
    </condition>
  </animation>

  <!-- ************** Mode B ************** -->
  <animation>
    <type>select</type>
    <object-name>modeB</object-name>
    <condition>
      <equals>
        <!-- <property>sim/model/mode</property> -->
        <property>/ai/models/multiplayer/sim/multiplay/generic/string[0]</property>
        <value>modeB</value>
      </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <condition>
      <!-- <property>sim/model/show-radar</property> -->
      <property>/ai/models/multiplayer/sim/multiplay/generic/bool[1]</property>
    </condition>
    <object-name>radar</object-name>
  </animation>

  <model>
    <path>Effects/light/all-lights.xml</path>
  </model>

  <!-- Roues sorties -->
  <animation>
    <type>select</type>
    <object-name>rouessorties</object-name>
    <object-name>portesouvertes</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>60</value>
      </less-than>
    </condition>
  </animation>

  <!-- Roues rentrée -->
  <animation>
    <type>select</type>
    <object-name>portesfermees</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>59</value>
      </greater-than>
    </condition>
  </animation>

</PropertyList>
