<?xml version="1.0"?>
<PropertyList>
  <fx>

    <engine>
        <name>t34engine</name>
        <mode>looped</mode>
        <path>AI/Aircraft/T-34/Sounds/t34engine.wav</path>
        <condition>
        <greater-than>
          <property>velocities/true-airspeed-kt</property>
          <value>1</value>
         </greater-than>
        </condition>
           <volume>
           <property>/engines/engine/mp-osi</property>
           <factor>0.005</factor>
           <min>0.15</min>
          <max>0.5</max>
        <offset>0.15</offset>
      </volume>
        <reference-dist>100.0</reference-dist>
        <max-dist>3000.0</max-dist>
    </engine>
 

    <engine>
     <name>t34accel</name>
      <path>AI/Aircraft/T-34/Sounds/t34accel.wav</path>
      <mode>looped</mode>
      <condition>
         <greater-than>
           <property>velocities/true-airspeed-kt</property>
           <value>5</value>
         </greater-than>
      </condition>
      <volume>
        <property>/engines/engine/mp-osi</property>
        <factor>0.005</factor>
        <min>0.15</min>
        <max>0.5</max>
        <offset>0.15</offset>
      </volume>
      <pitch>
        <property>/engines/engine/rpm</property>
        <factor>0.0012</factor>
        <min>0.3</min>
        <max>2.0</max>
        <offset>0.3</offset>
        </pitch>
    </engine>

    <!-- MG fire - 7.62mm, rifle caliber -->
<fire-mg>
  <name>fire-mg</name>
  <path>AI/Aircraft/Bombable-Sounds/fire-mg.wav</path>

  <mode>once</mode>

  <condition>
    <property>bombable/fire-trigger-mg</property>
  </condition>

  <volume>
    <max>0.5</max>
  </volume>

  <reference-dist>80</reference-dist>
  <max-dist>1000</max-dist>
</fire-mg>

    <!-- Heavy MG fire - .50cal, 12.7mm -->
    <fire-heavy-mg>
      <name>fire-heavy-mg</name>
      <path>AI/Aircraft/Bombable-Sounds/fire-heavy-mg.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/fire-trigger-heavy-mg</property>
      </condition>
      <volume>
        <max>0.5</max>
      </volume>
      <reference-dist>50</reference-dist>
      <max-dist>800</max-dist>
    </fire-heavy-mg>

    <!-- Cannon fire - 20mm-40mm -->
    <fire-cannon>
      <name>fire-cannon</name>
      <path>AI/Aircraft/Bombable-Sounds/fire-cannon.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/fire-trigger-cannon</property>
      </condition>
  <volume>
    <max>0.5</max>
  </volume>

  <reference-dist>80</reference-dist>
  <max-dist>1000</max-dist>
    </fire-cannon>

    <!-- Shell fire - 76mm+ tank/artillery -->
    <fire-shell>
      <name>fire-shell</name>
      <path>AI/Aircraft/Bombable-Sounds/fire-shell.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/fire-trigger-shell</property>
      </condition>
      <volume>
        <offset>0.2</offset>
        <min>0.3</min>
        <max>1.0</max>
        <factor>0.005</factor>
      </volume>
      <reference-dist>50</reference-dist>
      <max-dist>800</max-dist>
    </fire-shell>

    <!-- Rocket fire -->
    <fire-rocket>
      <name>fire-rocket</name>
      <path>AI/Aircraft/Bombable-Sounds/fire-rocket.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/fire-trigger-rocket</property>
      </condition>
      <volume>
        <offset>0.2</offset>
        <min>0.3</min>
        <max>1.0</max>
        <factor>0.005</factor>
      </volume>
      <reference-dist>50</reference-dist>
      <max-dist>800</max-dist>
    </fire-rocket>

    <!-- Missile fire -->
    <fire-missile>
      <name>fire-missile</name>
      <path>AI/Aircraft/Bombable-Sounds/fire-missile.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/fire-trigger-missile</property>
      </condition>
      <volume><offset>3.0</offset><max>4.0</max></volume>
      <reference-dist>1</reference-dist>
      <max-dist>10000</max-dist>
    </fire-missile>

    <!-- Bomb/torpedo release -->
    <fire-bomb>
      <name>fire-bomb</name>
      <path>AI/Aircraft/Bombable-Sounds/fire-bomb.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/fire-trigger-bomb</property>
      </condition>
      <volume>
        <offset>0.2</offset>
        <min>0.3</min>
        <max>1.0</max>
        <factor>0.005</factor>
      </volume>
      <reference-dist>50</reference-dist>
      <max-dist>800</max-dist>
    </fire-bomb>

<!-- Shell/cannon impact -->
    <impact-shell>
      <name>impact-shell</name>
      <path>AI/Aircraft/Bombable-Sounds/impact-shell.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/impact-trigger-shell</property>
      </condition>
      <volume>
        <offset>0.2</offset>
        <min>0.3</min>
        <max>1.0</max>
        <factor>0.005</factor>
      </volume>
      <reference-dist>50</reference-dist>
      <max-dist>800</max-dist>
    </impact-shell>

    <!-- Rocket/missile/bomb impact -->
    <impact-explosion>
      <name>impact-explosion</name>
      <path>AI/Aircraft/Bombable-Sounds/impact-rocket.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/impact-trigger-explosion</property>
      </condition>
      <volume>
        <offset>0.2</offset>
        <min>0.3</min>
        <max>1.0</max>
        <factor>0.005</factor>
      </volume>
      <reference-dist>50</reference-dist>
      <max-dist>800</max-dist>
    </impact-explosion>

    <!-- MG impact -->
    <impact-mg>
      <name>impact-mg</name>
      <path>AI/Aircraft/Bombable-Sounds/impact-mg.wav</path>
      <mode>once</mode>
      <condition>
        <property>bombable/impact-trigger-mg</property>
      </condition>
      <volume>
        <offset>0.2</offset>
        <min>0.3</min>
        <max>0.7</max>
        <factor>0.005</factor>
      </volume>
      <reference-dist>50</reference-dist>
      <max-dist>800</max-dist>
    </impact-mg>

    <!-- Ambient fire - distant AI shooting at other AI (softer volume) -->
    <ambient-mg>
     <name>ambient-mg</name>
     <path>AI/Aircraft/Bombable-Sounds/fire-mg.wav</path>
     <mode>once</mode>
     <condition><property>/bombable/ambient-trigger-mg</property></condition>
  <volume>
    <offset>0.03</offset>
  </volume>

  <reference-dist>80</reference-dist>
  <max-dist>1000</max-dist>
    </ambient-mg>

    <ambient-rocket>
     <name>ambient-rocket</name>
     <path>AI/Aircraft/Bombable-Sounds/impact-rocket.wav</path>
     <mode>once</mode>
      <condition><property>/bombable/ambient-trigger-rocket</property></condition>
  <volume>
    <offset>0.03</offset>
  </volume>

  <reference-dist>80</reference-dist>
  <max-dist>1000</max-dist>
    </ambient-rocket>


  </fx>
</PropertyList>
