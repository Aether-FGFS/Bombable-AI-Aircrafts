<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>
<!-- gun -->	
	<submodel>
		<name>gun</name>
		<model>Aircraft/T-34/Models/Effects/fire.xml</model>
		<trigger>controls/armament/station[2]/gun</trigger>
		<speed>30</speed>
		<repeat>true</repeat>
		<delay>12</delay>
		<count>-1</count>
		<!-- <x-offset>15</x-offset>
		<y-offset>0</y-offset>
		<z-offset>11</z-offset> -->
		<x-offset>16.5</x-offset>
		<y-offset>0</y-offset>
		<z-offset>7</z-offset>
		<yaw-offset>0</yaw-offset>
		<pitch-offset>5</pitch-offset>
		<life>0.4</life>
		<buoyancy>32</buoyancy>
		<eda>1</eda>
		<cd>0.2</cd>
		<!--<random>true</random>
		<no-roll>true</no-roll>-->
	</submodel>
	
	<submodel>
		<name>gun-smoke</name>
		<model>Aircraft/T-34/Models/Effects/smoke.xml</model>
		<trigger>controls/armament/station[2]/gun</trigger>
		<speed>30</speed>
		<repeat>true</repeat>
		<delay>12</delay>
		<count>-1</count>
		<!-- <x-offset>13</x-offset>
		<y-offset>0</y-offset>
		<z-offset>11</z-offset> -->
		<x-offset>15</x-offset>
		<y-offset>0</y-offset>
		<z-offset>7</z-offset>
		<yaw-offset>0</yaw-offset>
		<pitch-offset>5</pitch-offset>
		<life>0.5</life>
		<buoyancy>32</buoyancy>
		<eda>1</eda>
		<cd>0.2</cd>
		<!--<random>true</random>
		<no-roll>true</no-roll>-->
	</submodel>

    <cannon>
    <model>Aircraft/T-34/Models/Weapons/guns/12mm/apibullet-tracer.xml</model>
    <!-- <trigger>controls/armament/trigger</trigger> -->
    <trigger>sim/multiplay/generic/int[10]</trigger>
    <speed>3363.0</speed>
    <cd>0.193</cd>
    <weight>0.9369635</weight>
    <eda>0.007609</eda>
    <fuse-range>0</fuse-range>
    <life>30</life>
    <expiry>true</expiry>
    <repeat>true</repeat>
    <delay>0.03</delay>
    <count>400</count>
    <wind>false</wind>
    <collision>true</collision>
    <collision-report>sim/ai/aircraft/collision/gun</collision-report>
    <impact>true</impact>
    <impact-report>sim/ai/aircraft/impact/bullet</impact-report>
    <submodel-path>Aircraft/T-34/Models/Weapons/guns/12mm/submodel.xml</submodel-path>
    <animation>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    </animation>
  </cannon>

  <!-- Gun -->
  <submodel>
    <name>cannon</name>
    <model         alias="../../cannon/model"/>
    <trigger       alias="../../cannon/trigger"/>
    <speed         alias="../../cannon/speed"/>
    <cd            alias="../../cannon/cd"/>
    <eda           alias="../../cannon/eda"/>
    <fuse-range    alias="../../cannon/fuse-range"/>
    <weight        alias="../../cannon/weight"/>
    <life          alias="../../cannon/life"/>
    <repeat        alias="../../cannon/repeat"/>
    <delay         alias="../../cannon/delay"/>
    <count         alias="../../cannon/count"/>
    <wind          alias="../../cannon/wind"/>
    <expiry        alias="../../cannon/expiry"/>
    <collision     alias="../../cannon/collision"/>
    <impact        alias="../../cannon/impact"/>
    <submodel-path alias="../../cannon/submodel-path"/>
    <animation     alias="../../cannon/animation"/>
    <offsets>
      <x-m> -3.364 </x-m>
      <y-m> -1.095 </y-m>
      <z-m>  0.500 </z-m>
    </offsets>
  </submodel>

</PropertyList>

