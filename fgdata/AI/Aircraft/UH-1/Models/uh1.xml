<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList include="UH-1-bombableinclude.xml">

  <path>uh1.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>uh1</object-name>
    <object-name>single</object-name>
    <object-name>double</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>uh1</object-name>
    <object-name>single</object-name>
    <object-name>double</object-name>
    <property-base>/ai/models/multiplayer/sim/multiplay/generic</property-base>
    <texture-prop>string[1]</texture-prop>
    <texture>/ai/models/multiplayer/sim/multiplay/generic/string[1]</texture>
  </animation>

  <!-- Sélection des éléments en fonction du type -->
  <animation>
    <type>select</type>
    <object-name>single</object-name>
    <condition>
      <equals>
        <!-- <property>sim/model/mode</property> -->
        <property>/ai/models/multiplayer/sim/multiplay/generic/string[0]</property>
        <value>uh1</value>
      </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>double</object-name>
    <condition>
      <or>
        <equals>
          <!-- <property>sim/model/mode</property> -->
          <property>/ai/models/multiplayer/sim/multiplay/generic/string[0]</property>
          <value>212</value>
        </equals>
        <equals>
          <!-- <property>sim/model/mode</property> -->
          <property>/ai/models/multiplayer/sim/multiplay/generic/string[0]</property>
          <value>412</value>
        </equals>
      </or>
    </condition>
  </animation>

  <model>
    <path>Effects/light/all-lights.xml</path>
  </model>

  <model>
    <path>Externals/MainRotor/all-mainrotor.xml</path>
  </model>

  <model>
    <path>Externals/TailRotor/all-tailrotor.xml</path>
  </model>

  <model>
    <path>Effects/Insecticid/all-sprayers.xml</path>
  </model>

  <model>
    <path>Effects/3D/all-guns.xml</path>
  </model>

</PropertyList>
