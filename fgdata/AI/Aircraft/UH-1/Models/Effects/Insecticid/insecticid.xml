<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <model>
    <name>InsecticidNOALS</name>
    <path>Classic/insecticid.xml</path>
  </model>

  <animation>
    <type>select</type>
    <object-name>InsecticidNOALS</object-name>
    <condition>
      <not><property>/sim/rendering/shaders/skydome</property></not>
    </condition>
  </animation>

  <model>
    <name>InsecticidALS</name>
    <path>ALS/insecticid.xml</path>
  </model>

  <animation>
    <type>select</type>
    <object-name>InsecticidALS</object-name>
    <condition>
      <property>/sim/rendering/shaders/skydome</property>
    </condition>
  </animation>

  <model>
    <name>InsecticidHDR</name>
    <path>HDR/insecticid.xml</path>
  </model>

  <animation>
    <type>select</type>
    <object-name>InsecticidHDR</object-name>
    <condition>
      <property>/sim/rendering/hdr/hdr-enabled</property>
    </condition>
  </animation>

</PropertyList>
