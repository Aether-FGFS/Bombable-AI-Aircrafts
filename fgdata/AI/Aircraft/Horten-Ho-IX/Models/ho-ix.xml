<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList include="Horten-Ho-IX-bombableinclude.xml">

  <path>ho-ix.ac</path>

  <sound>
     <path>AI/Aircraft/Horten-Ho-IX/Sounds/ai-sound.xml</path>
  </sound>

  <animation>
    <!-- Objets opaques -->
    <object-name>ho-ix</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>

    <object-name>rouessorties</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>ho-ix</object-name>
    <object-name>portesfermees</object-name>
    <object-name>portesouvertes</object-name>
    <object-name>rouessorties</object-name>
    <property-base>/ai/models/multiplayer/sim/multiplay/generic</property-base>
    <texture-prop>string[1]</texture-prop>
    <texture>/ai/models/multiplayer/sim/multiplay/generic/string[1]</texture>
  </animation>

  <model>
    <path>Effects/light/all-lights.xml</path>
  </model>

  <!-- Roues sorties -->
  <animation>
    <type>select</type>
    <object-name>rouessorties</object-name>
    <object-name>portesouvertes</object-name>
    <condition>
      <less-than>
        <property>velocities/true-airspeed-kt</property>
        <value>60</value>
      </less-than>
    </condition>
  </animation>

  <!-- Roues rentrée -->
  <animation>
    <type>select</type>
    <object-name>portesfermees</object-name>
    <condition>
      <greater-than>
        <property>velocities/true-airspeed-kt</property>
        <value>59</value>
      </greater-than>
    </condition>
  </animation>

</PropertyList>
